# PostgreSQL connection string (e.g. from Vercel Postgres, Supabase, or Neon)
DATABASE_URL="postgresql://user:password@host:5432/brounic_dashboard"

# NextAuth
NEXTAUTH_URL="https://brounic.com/dashboard"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# First admin account, created by `npx prisma db seed`
SEED_ADMIN_EMAIL="admin@brounic.com"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
